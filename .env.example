NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set a private random signing secret of at least 32 characters for production.
JWT_SECRET=

DB_DRIVER=mysql
DB_TARGET=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neighborlens_ai
DB_CONNECTION_LIMIT=10

UPLOAD_DIR=storage/uploads
DAMAGE_INFERENCE_URL=
DAMAGE_INFERENCE_PROVIDER=roboflow
ROBOFLOW_API_KEY=replace-with-server-only-roboflow-key
ROBOFLOW_MODEL=damages-detection-ixvjc-zolih
ROBOFLOW_VERSION=3
DAMAGE_MODEL=yolov8-neighborlens
DAMAGE_TASK=detect
DAMAGE_MIN_CONFIDENCE=0.3


BACOLOD_BBOX_MAX_LAT=10.90
BACOLOD_BBOX_MIN_LNG=122.75
BACOLOD_BBOX_MAX_LNG=123.20
MAX_GPS_ACCURACY_METERS=100


# OCR-only registration requires development, loopback HOST and DB_HOST, and a local MySQL DB_NAME ending in _test.
REGISTRATION_FRAUD_SCREENING_ENABLED=true
REGISTRATION_FRAUD_URL=http://127.0.0.1:8001/assess-capture
# Private ASCII secret of at least 32 characters used to authenticate Identity/OCR and signed fraud requests.
REGISTRATION_FRAUD_SECRET=
REGISTRATION_FINGERPRINT_KEY=
REGISTRATION_KNOWN_REPLAY_SHA256_FILE=

REGISTRATION_BASIC_CITIZEN_ENABLED=false
REGISTRATION_CAPTURE_TESSERACT=
REGISTRATION_ALLOW_OUTSIDE_BACOLOD_SCAN=false

REGISTRATION_VERIFIER_URL=
REGISTRATION_VERIFIER_SECRET=
REGISTRATION_REVIEWER_IDS=

IDENTITY_RESEARCH_MODEL=none
IDENTITY_RESEARCH_DEVICE=cpu
IDENTITY_API_PORT=8001
FREUID_ASSETS=
FREUID_RESEARCH_LAYOUT=
TRUFOR_SOURCE=
TRUFOR_WEIGHTS_ARCHIVE=


AI_MODEL_WEIGHTS=models/production/best.pt
AI_HOST=127.0.0.1
AI_PORT=8000
AI_CONFIDENCE=0.30
AI_IMAGE_SIZE=640

# Storage
STORAGE_DRIVER=supabase

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.com
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_STORAGE_BUCKET=neighborlens-reports
