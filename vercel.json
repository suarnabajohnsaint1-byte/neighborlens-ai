{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "frontend/*.html", "use": "@vercel/static" },
    { "src": "frontend/js/**", "use": "@vercel/static" },
    { "src": "frontend/styles/**", "use": "@vercel/static" },
    { "src": "frontend/assets/**", "use": "@vercel/static" },
    { "src": "shared/*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/frontend/login.html" },
    { "src": "^/api(?:/.*)?$", "dest": "/api/index.js" },
    { "src": "^/(index|login|admin-login|admin-signup|barangay-login|citizen|report-details|admin|barangay)\\.html$", "dest": "/frontend/$1.html" },
    { "src": "^/(js|styles|assets)/(.+)$", "dest": "/frontend/$1/$2" },
    { "src": "^/shared/(reportVocabulary|manilaDates|geoContainment|identityDocumentPolicy)\\.js$", "dest": "/shared/$1.js" }
  ]
}
